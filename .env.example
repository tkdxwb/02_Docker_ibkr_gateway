# =============================================================================
# 三个 LIVE 账户配置模板
#   使用前: cp .env.example .env   然后填写下面的凭证与 VNC 密码
#   .env 已被 .gitignore 忽略, 不会进版本库
# =============================================================================

# ---- 账户 1 ----  (容器 ib-gateway-1)
ACCT1_USERID=
ACCT1_PASSWORD=
ACCT1_API_PORT=4001        # 主机 API 端口 -> 容器内 socat 4003 -> gateway 4001
ACCT1_VNC_PORT=5900        # 主机 VNC 端口

# ---- 账户 2 ----  (容器 ib-gateway-2)
ACCT2_USERID=
ACCT2_PASSWORD=
ACCT2_API_PORT=4011
ACCT2_VNC_PORT=5901

# ---- 账户 3 ----  (容器 ib-gateway-3)
ACCT3_USERID=
ACCT3_PASSWORD=
ACCT3_API_PORT=4021
ACCT3_VNC_PORT=5902

# ---- 三个容器共用 ----
# 必填: 否则 VNC 不启动, 首次登录/2FA 将无法操作
VNC_SERVER_PASSWORD=

TRADING_MODE=live
# 2FA 超时后自动重启并重新登录, 适合无人值守的 live 账户
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
# 每天定时重启 (IBKR 会每日强制断线, 设此项可自动恢复)
AUTO_RESTART_TIME=11:59 PM
# 时区, 例如 Asia/Shanghai / America/New_York / Europe/London
TIME_ZONE=Etc/UTC
READ_ONLY_API=no

# ---- 可选高级项 (按需取消注释, 完整说明见 README.md) ----
#TWS_ACCEPT_INCOMING=manual
#BYPASS_WARNING=
#JAVA_HEAP_SIZE=
#ALLOW_BLIND_TRADING=no
#EXISTING_SESSION_DETECTED_ACTION=primary
# SSH 隧道相关:
#SSH_TUNNEL=
#SSH_USER_TUNNEL=
#SSH_REMOTE_PORT=
